#############################################################################
##
#P  IsAutomatonGroup( <G> )
##
##  <#GAPDoc Label="IsAutomatonGroup">
##  <ManSection>
##  <Prop Name="IsAutomatonGroup" Arg="G"/>
##  <Description>
##  is <K>true</K> if <A>G</A> is created using the command <Ref Func="AutomatonGroup"/>
##  or if the generators of <A>G</A> coincide with the generators of the corresponding family, and <K>false</K> otherwise.
##  To test whether <A>G</A> is self-similar use <Ref Func="IsSelfSimilar"/> command.
##  </Description>
##  </ManSection>
##  <#/GAPDoc>
DeclareProperty("IsAutomatonGroup", IsAutomGroup);
InstallTrueMethod(IsGroupOfAutomFamily, IsAutomatonGroup);


#############################################################################
##
#A  MihailovaSystem( <G> )
##
##  <#GAPDoc Label="MihailovaSystem">
##  <ManSection>
##  <Attr Name="MihailovaSystem" Arg="G"/>
##  <Description>
##  In the case when <A>G</A> is an automaton fractal group acting on a binary
##  tree, computes the generating set for the first level stabilizer in G
##  such that the sections of these generators at the first level,
##  viewed as elements of <M>F_r\times F_r</M>, are in Mihailova normal form.
##  See&nbsp;<Cite Key="GSESS"/> for details.
##  <Example><![CDATA[
##  gap> G := AutomatonGroup("a=(b,c)(1,2),b=(a,c),c=(a,a)");
##  < a, b, c >
##  gap> M := MihailovaSystem(G);
##  [ c^-1*b, c^-1*b^-1*c*a^-1*b*c*b^-1*a, a^-1*b*c*b^-1*a, a*c^-1*b^-1*a*c, 
##    c^-1*a^-1*b*c*a ]
##  gap> for g in M do
##  >      Print(g,"=",Decompose(g),"\n");
##  >    od;
##  c^-1*b=(1, a^-1*c)
##  c^-1*b^-1*c*a^-1*b*c*b^-1*a=(1, a^-1*c^-1*a*b^-1*a*b)
##  a^-1*b*c*b^-1*a=(a, b^-1*a*b)
##  a*c^-1*b^-1*a*c=(b, c*a^-2*b*a)
##  c^-1*a^-1*b*c*a=(c, a^-1*b^-1*a^2*b)
##  ]]></Example>
##  </Description>
##  </ManSection>
##  <#/GAPDoc>
DeclareAttribute("MihailovaSystem", IsAutomatonGroup, "mutable");


